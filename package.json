{
  "name": "@local/brain",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Write notes in the left sidebar, let the agent file what matters, and keep it all as an Obsidian-compatible Markdown vault in GitHub.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
