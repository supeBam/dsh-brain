{
  "name": "@local/brain",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "DeepSeek Harness sidebar second brain: a local-first Markdown vault, Obsidian-compatible, auto-synced to your own private GitHub repository.",
  "type": "module",
  "icon": "icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/supeBam/dsh-brain.git"
  },
  "homepage": "https://github.com/supeBam/dsh-brain",
  "bugs": {
    "url": "https://github.com/supeBam/dsh-brain/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "markdown",
    "obsidian",
    "second-brain",
    "notes"
  ]
}
